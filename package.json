{
  "name": "takeoff",
  "version": "0.1.0",
  "private": true,
  "description": "An incremental browser game about an AI lab racing to superintelligence.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "serve": "node scripts/serve.mjs",
    "dev": "tsc && node scripts/serve.mjs",
    "sim": "tsc && node dist/sim/bot.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
