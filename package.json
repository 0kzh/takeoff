{
  "name": "takeoff",
  "version": "0.1.0",
  "private": true,
  "description": "An incremental browser game about an AI lab racing to superintelligence.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tools/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sim": "tsx src/sim/bot.ts",
    "test:browser": "node tools/verify/smoke.ts",
    "format": "prettier --write src tests tools vite.config.ts eslint.config.ts index.html",
    "format:check": "prettier --check src tests tools vite.config.ts eslint.config.ts index.html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22.18"
  }
}
